# Foundry (local run). azd injects these automatically for `azd ai agent run` and in Foundry.
FOUNDRY_PROJECT_ENDPOINT="https://<account>.services.ai.azure.com/api/projects/<project>"
AZURE_AI_MODEL_DEPLOYMENT_NAME="gpt-6.1-sol"

# Scope of the SQL HA tools (comma-separated). Empty = everything the identity can read.
SQLHA_SUBSCRIPTION_IDS="<subscription-id>"
SQLHA_RESOURCE_GROUPS="<arc-resource-group>"

# Allow patch assessment, patch installation and AG failover tools to execute (default false = preview only).
SQLHA_ENABLE_WRITE_ACTIONS="false"
# Hosted agent only: never_require | always_require (human approval of write tool calls in the Foundry client).
SQLHA_WRITE_APPROVAL_MODE="never_require"
