# Azure Developer CLI environment variables
# Copy to .azure/<env-name>/.env and fill in values

AZURE_SUBSCRIPTION_ID=e4718866-4e88-411f-a0b8-10c8051dc165
AZURE_LOCATION=westus

# Existing VNet and VPN
AZURE_EXISTING_VNET_NAME=vnet-westus
AZURE_EXISTING_VNET_RESOURCE_GROUP=vnet
AZURE_VPN_CLIENT_ADDRESS_PREFIX=10.255.0.0/27

# Dedicated SQL HA network
AZURE_DC_SUBNET_PREFIX=10.0.9.0/24
AZURE_SQL1_SUBNET_PREFIX=10.0.10.0/24
AZURE_SQL2_SUBNET_PREFIX=10.0.11.0/24
AZURE_DC_PRIVATE_IP=10.0.9.4
AZURE_SQL1_PRIVATE_IP=10.0.10.4
AZURE_SQL2_PRIVATE_IP=10.0.11.4
AZURE_CLUSTER_IP1=10.0.10.10
AZURE_CLUSTER_IP2=10.0.11.10
AZURE_LISTENER_IP1=10.0.10.11
AZURE_LISTENER_IP2=10.0.11.11

# VM admin credentials
AZURE_ADMIN_USERNAME=azureadmin
AZURE_ADMIN_PASSWORD=

# Active Directory
AZURE_DOMAIN_FQDN=contoso.local
AZURE_DOMAIN_NETBIOS=CONTOSO

# Service accounts (UPN format)
AZURE_SQL_SERVICE_ACCOUNT=sqlservice@contoso.local
AZURE_SQL_SERVICE_PASSWORD=
AZURE_SQL_ADMIN_LOGIN=sqladmin
AZURE_SQL_ADMIN_PASSWORD=
AZURE_CLUSTER_OPERATOR_ACCOUNT=clusteradmin@contoso.local
AZURE_CLUSTER_OPERATOR_PASSWORD=
AZURE_CLUSTER_BOOTSTRAP_ACCOUNT=clusteradmin@contoso.local
AZURE_CLUSTER_BOOTSTRAP_PASSWORD=

# SQL Server
AZURE_SQL_IMAGE_OFFER=sql2022-ws2022
AZURE_SQL_IMAGE_SKU=Enterprise
